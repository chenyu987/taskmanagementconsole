# 前端（Vite）变量，放在 .env.local。运行 `npx convex dev` 会自动写入 CONVEX_DEPLOYMENT 和 VITE_CONVEX_URL。
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# 后端变量不放文件里，用 `npx convex env set` 设置到 Convex 部署上：
#   SITE_URL              前端地址，本地为 http://localhost:5173，线上为 Cloudflare 上的前端域名
#   BETTER_AUTH_SECRET    随机字符串：openssl rand -base64 32
